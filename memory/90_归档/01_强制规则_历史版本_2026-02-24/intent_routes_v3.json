          "supplier_kb",
          "erp_read",
          "retrieval",
          "search_web",
          "risk_scoring_tool",
          "table_ops"
        ],
        "tool_allowlist_post_gate": ["supplier_switch_execute_scoped", "erp_write_scoped"]
      },
      "qc": {
        "min_score": 0.93,
        "rubric": {
          "weights": {
            "completeness": 0.35,
            "accuracy": 0.6,
            "format": 0.05
          },
          "checklist": ["输出替代方案对比表", "给出迁移计划与回退策略", "执行动作必须经human_gate"]
        }
      },
      "tool_policy": {
        "allow": [
          "supplier_kb",
          "erp_read",
          "search_web",
          "retrieval",
          "risk_scoring_tool",
          "table_ops"
        ],
        "deny": ["supplier_switch_execute", "erp_write"]
      },
      "secondary_router": {
        "routes": [
          {
            "subroute_id": "SC2.evaluate",
            "when": {
              "sub_intent": "evaluation",
              "op_type": "decision"
            },
            "execution": {
              "dag_template": "hybrid_rewoo_reflexion",
              "timeout_s": 210
            },
            "need_parallel": true,
            "qc": {
              "min_score": 0.93
            }
          },
          {
            "subroute_id": "SC2.switch_plan_only",
            "when": {
              "sub_intent": "plan",
              "op_type": "decision"
            },
            "execution": {
              "dag_template": "rewoo_strict",
              "timeout_s": 170
            },
            "need_parallel": true,
            "qc": {
              "min_score": 0.92
            }
          },
          {
            "subroute_id": "SC2.execute",
            "when": {
              "sub_intent": "execute",
              "op_type": "mutation"
            },
            "execution": {
              "dag_template": "rewoo_guided_react_human_gate",
              "timeout_s": 220
            },
            "need_parallel": false,
            "qc": {
              "min_score": 0.97
            }
          }
        ]
      }
    }
  ],
  "dag_templates_registry": {
    "react_basic": {
      "pattern": "graph",
      "nodes": ["solver", "judge"],
      "loops": {
        "enabled": false
      }
    },
    "rewoo_strict": {
      "pattern": "workflow",
      "nodes": ["planner", "worker", "solver", "judge"],
      "worker": {
        "evidence_ledger": true,
        "tool_policy": "plan_authorized_only"
      },
      "solver": {
        "tool_access": false
      }
    },
    "rewoo_parallel_research": {
      "pattern": "workflow",
      "nodes": ["planner", "research_swarm", "solver", "judge"],
      "research_swarm": {
        "max_subagents": 5,
        "merge_strategy": "map_reduce_conflict_aware"
      }
    },
    "rewoo_data_analysis": {
      "pattern": "workflow",
      "nodes": ["planner", "data_worker", "analyst", "judge"],
      "data_worker": {
        "tool_policy": "data_read_only"
      }
    },
    "reflexion_bounded": {
      "pattern": "graph",
      "nodes": ["solver", "judge"],
      "loops": {
        "enabled": true,
        "max_iterations": 3,
        "exit_on": "judge.passed == true"
      }
    },
    "hybrid_rewoo_reflexion": {
      "pattern": "workflow",
      "nodes": ["planner", "worker", "solver", "judge"],
      "loops": {
        "enabled": true,
        "max_iterations": 2,
        "scope": "solver+judge"
      },
      "worker": {
        "evidence_ledger": true
      }
    },
    "rewoo_guided_react_human_gate": {
      "pattern": "workflow",
      "nodes": ["planner", "worker", "human_gate", "solver", "judge"],
      "human_gate": {
        "position": "before_solver"
      },
      "worker": {
        "evidence_ledger": true
      },
      "fallback": {
        "on_gate_reject": "downgrade_deliverable",
        "on_timeout": "downgrade_deliverable"
      }
    },
    "fast_copywriter_parallel": {
      "pattern": "swarm",
      "nodes": ["copy_variant_1", "copy_variant_2", "copy_variant_3", "judge", "solver"],
      "swarm": {
        "max_subagents": 3,
        "merge_strategy": "best_of_n"
      }
    },
    "workflow_kpi_snapshot": {
      "pattern": "workflow",
      "nodes": ["data_fetch", "metric_compute", "table_render", "judge"],
      "loops": {
        "enabled": false
      }
    },
    "workflow_social_scan": {
      "pattern": "workflow",
      "nodes": ["social_fetch", "dedup_cluster", "summary", "judge"],
      "loops": {
        "enabled": false
      }
    },
    "dev_hybrid_repro_patch_test": {
      "pattern": "workflow",
      "nodes": ["repro", "patch", "tests", "judge"],
      "tests": {
        "tool_policy": "no_exec_by_default"
      }
    }
  },
  "triage_contract": {
    "required_fields": [
      "bucket_id",
      "sub_intent",
      "op_type",
      "risk",
      "complexity",
      "need_parallel",
      "confidence"
    ],
    "enums": {
      "op_type": ["read", "decision", "mutation"],
      "sub_intent_examples": [
